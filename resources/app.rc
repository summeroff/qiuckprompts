#include "resource.h"

#ifndef QP_VERSION_MAJOR
#define QP_VERSION_MAJOR 0
#endif
#ifndef QP_VERSION_MINOR
#define QP_VERSION_MINOR 2
#endif
#ifndef QP_VERSION_PATCH
#define QP_VERSION_PATCH 0
#endif

IDI_APPICON ICON "app.ico"

1 VERSIONINFO
FILEVERSION    QP_VERSION_MAJOR,QP_VERSION_MINOR,QP_VERSION_PATCH,0
PRODUCTVERSION QP_VERSION_MAJOR,QP_VERSION_MINOR,QP_VERSION_PATCH,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "qiuckprompts"
            VALUE "FileDescription",  "QiuckPrompts tray hotkey AI workflow"
            VALUE "FileVersion",      "0.2.0"
            VALUE "InternalName",     "qiuckprompts"
            VALUE "OriginalFilename", "qiuckprompts.exe"
            VALUE "ProductName",      "QiuckPrompts"
            VALUE "ProductVersion",   "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
